{
  "name": "genesis-functions",
  "version": "2.0.0",
  "private": true,
  "description": "Genesis - Firebase Cloud Functions (API, OAuth, SSE generation, HighLevel proxy)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^4.15.9"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:rules": "vitest run --config vitest.rules.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "firebase": "^12.19.0",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  }
}
