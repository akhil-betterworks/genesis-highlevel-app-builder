# Genesis — root env (local only, never commit the real .env)
# `npm run setup` reads this file and generates:
#   functions/.env, functions/.secret.local, frontend/.env.local

# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# HighLevel Marketplace app (marketplace.gohighlevel.com → My Apps → Auth)
HL_CLIENT_ID=
HL_CLIENT_SECRET=

# AI provider: anthropic (paid) | gemini (FREE, no card) | groq (free) | openrouter (free models) | ollama (local, free)
LLM_PROVIDER=gemini
# Key for gemini/groq/openrouter (Gemini: https://aistudio.google.com/apikey)
LLM_API_KEY=
# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional overrides (empty = provider default model)
LLM_MODEL=
LLM_MAX_TOKENS=16000
